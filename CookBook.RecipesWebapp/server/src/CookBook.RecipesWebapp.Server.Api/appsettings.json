{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System": "Warning",
      "Microsoft": "Warning"
    }
  },

  "AllowedHosts": "*",

  "SpaClientConfiguration": {
    "IsSpaEnabled": true,
    "StaticFilesRootPath": "client/build",
    "UseDevelopmentProxyServer": false
  },

  "OpenIdConnectAppConfiguration": {
    "Authority": "http://localhost:8020",
    "MetadataAddress": "http://cookbook-identity-provider-container:8020/.well-known/openid-configuration",
    "ClientId": "CookBook.RecipesWebApp",
    "ClientSecret": "c0741d5c-f119-4b19-be90-08b6bd1084bf",
    "Scopes": {
      "CookBookRecipesReadWrite": "CookBook.Recipes.ReadWrite",
      "CookBookIdentityProviderReadWrite": "CookBook.IdentityProvider.ReadWrite"
    }
  },

  "RecipesApiConfiguration": {
    "BaseAddress": "http://cookbook-recipes-container:8010"
  },

  "IdentityProviderApiConfiguration": {
    "BaseAddress": "http://cookbook-identity-provider-container:8020"
  },

  "ReverseProxyConfiguration": {
    "HttpRequest": {
      "ActivityTimeout": "00:00:30",
      "Version": "1.1",
      "VersionPolicy": "RequestVersionOrHigher",
      "AllowResponseBuffering": "false"
    },
    "Routes": {
      "RecipeApiGetLatestRecipesRoute": {
        "ClusterId": "RecipesApi",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/recipes/latest",
          "Methods": [
            "GET"
          ]
        },
        "MetaData": {
        },
        "Transforms": [
          {
            "PathPattern": "/api/recipes/latest"
          },
          {
            "RequestHeaderOriginalHost": "false"
          }
        ]
      },
      "RecipesApiSearchRecipesRoute": {
        "ClusterId": "RecipesApi",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/recipes/search",
          "Methods": [
            "GET"
          ]
        },
        "MetaData": {
        },
        "Transforms": [
          {
            "PathPattern": "/api/recipes/search"
          },
          {
            "RequestHeaderOriginalHost": "false"
          }
        ]
      },
      "RecipeApiSaveRecipeRoute": {
        "ClusterId": "RecipesApi",
        "AuthorizationPolicy": "Cookie",
        "Match": {
          "Path": "/api/recipes/save",
          "Methods": [
            "PUT"
          ]
        },
        "MetaData": {
          "UseAntiforgeryValidation": "true",
          "UseOpenIdConnect": "true"
        },
        "Transforms": [
          {
            "PathPattern": "/api/recipes/save"
          },
          {
            "RequestHeaderOriginalHost": "false"
          }
        ]
      },
      "RecipeApiRemoveRecipeRoute": {
        "ClusterId": "RecipesApi",
        "AuthorizationPolicy": "Cookie",
        "Match": {
          "Path": "/api/recipes/{recipeId}/remove",
          "Methods": [
            "DELETE"
          ]
        },
        "MetaData": {
          "UseAntiforgeryValidation": "true",
          "UseOpenIdConnect": "true"
        },
        "Transforms": [
          {
            "PathPattern": "/api/recipes/{recipeId}/remove"
          },
          {
            "RequestHeaderOriginalHost": "false"
          }
        ]
      },
      "IdentityProviderApiChangeDisplayNameRoute": {
        "ClusterId": "IdentityProviderApi",
        "AuthorizationPolicy": "Cookie",
        "Match": {
          "Path": "/api/users/current/display-name",
          "Methods": [
            "PATCH"
          ]
        },
        "MetaData": {
          "UseAntiforgeryValidation": "true",
          "UseOpenIdConnect": "true"
        },
        "Transforms": [
          {
            "PathPattern": "/api/users/current/display-name"
          },
          {
            "RequestHeaderOriginalHost": "false"
          }
        ]
      }
    },
    "Clusters": {
      "RecipesApi": {
        "Destinations": {
          "main": {
            "Address": "http://cookbook-recipes-container:8010"
          }
        },
        "MetaData": {
          "OpenApiDocumentUrl": "/.less-known/api-docs/v1.json"
        }
      },
      "IdentityProviderApi": {
        "Destinations": {
          "main": {
            "Address": "http://cookbook-identity-provider-container:8020"
          }
        }
      }
    }
  }
}
